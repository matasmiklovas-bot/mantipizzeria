# Nustatymai ir raktai. Tikros reikšmės į git nepatenka.
#
# Svetainei (Vercel): šias eilutes įrašyk Vercel → Project → Settings →
# Environment Variables. Failo .env ten nereikia.
# Komandinės eilutės įrankiui (Windows): nukopijuok šį failą į ".env".
# Niekada nesiųsk raktų žinute ir nekelk jų į GitHub.

# --- Svetainė ---------------------------------------------------------------

# Viešas svetainės adresas, be pasvirojo brūkšnio gale. Naudojamas nuorodoms laiškuose.
SITE_URL=https://tavo-domenas.lt

# Valdymo puslapio (/valdymas) slaptažodis. Bent 10 ženklų, geriau 16+.
ADMIN_PASSWORD=

# Atsitiktinė 32+ ženklų eilutė prisijungimo sesijai pasirašyti.
# Susigeneruok, pvz., https://1password.com/password-generator (40 ženklų).
SESSION_SECRET=

# Kur siųsti pranešimus apie naujus užsakymus ir kliento patvirtinimus.
OWNER_EMAIL=

# Adresas, kuriuo klientai gali rašyti (rodomas svetainėje ir laiškuose).
CONTACT_EMAIL=

# --- Supabase (duomenų bazė ir privati failų saugykla) -----------------------
# Supabase → Project Settings → API. Naudok "service_role" raktą, ne "anon".
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (mokėjimai) -------------------------------------------------------
# Stripe → Developers → API keys. Tikram darbui reikia sk_live_... rakto.
STRIPE_SECRET_KEY=
# Stripe → Developers → Webhooks → tavo endpoint → Signing secret (whsec_...).
STRIPE_WEBHOOK_SECRET=

# --- Resend (el. laiškai) -----------------------------------------------------
RESEND_API_KEY=
# Siuntėjas. Domenas turi būti patvirtintas Resend paskyroje.
EMAIL_FROM=Snukutis <uzsakymai@tavo-domenas.lt>

# --- Reklamos pikseliai (IŠJUNGTA, kol tuščia) --------------------------------
# Įrašius ID, lankytojams atsiras sutikimo juosta; pikselis kraunamas tik sutikus.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# --- Komandinės eilutės įrankis (vaizdo modelis) ------------------------------
# fal.ai API raktas (https://fal.ai → Dashboard → API Keys).
# Be jo veikia viskas, išskyrus generavimą: tada naudok --paruostas-portretas.
FAL_KEY=
# Nebūtina. Numatytasis modelis: fal-ai/nano-banana-pro/edit
# PORTRETAS_MODELIS=
# Nebūtina. Modelio raiška: 1K, 2K arba 4K. Numatytoji: 2K.
# PORTRETAS_RAISKA=
