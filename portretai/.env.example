# Nukopijuok šį failą į ".env" ir įrašyk savo reikšmes.
# ".env" failas į git nepatenka. Niekada nesiųsk jo niekam ir nekelk į internetą.

# fal.ai API raktas (https://fal.ai -> Dashboard -> API Keys).
# Be jo veikia viskas, išskyrus generavimą: tada naudok --paruostas-portretas.
FAL_KEY=

# Nebūtina. Kitas vaizdo modelis fal.ai platformoje.
# Numatytasis: fal-ai/nano-banana-pro/edit
# PORTRETAS_MODELIS=

# Nebūtina. Modelio išvesties raiška: 1K, 2K arba 4K. Numatytoji: 2K.
# 4K kainuoja dvigubai, bet 30x40 cm plakatui beveik nereikia didinti.
# PORTRETAS_RAISKA=
