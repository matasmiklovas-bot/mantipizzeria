# Postgres. On Vercel: Storage → Create Database → Neon → Connect fills this in.
DATABASE_URL=

# Optional Google sign-in (username + password always works) (console.cloud.google.com → APIs & Services → Credentials → OAuth client ID → Web application).
# Authorized redirect URI: https://<your-domain>/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Any long random string (signs the login cookie). For example: openssl rand -base64 32
AUTH_SECRET=

# Optional. Owner (can delete, set roles). Default: whoever registers first.
OWNER_USERNAME=
OWNER_EMAIL=
# Optional. Who may sign in: comma list of emails or @domains. Default: anyone with a Google account.
ALLOWED_EMAILS=

# Optional. Enables "Ieškoti su AI" (Anthropic API key from console.anthropic.com).
ANTHROPIC_API_KEY=
